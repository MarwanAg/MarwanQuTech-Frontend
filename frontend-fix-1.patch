From 6a6a23bbaebd514945f1bde441f220010e32dd3a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 19:39:33 +0300
Subject: [PATCH] Ignore extension-added attributes on <body> during hydration

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CmV2Um4oXgPKfStsph5DSD
---
 src/app/[locale]/layout.tsx | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/app/[locale]/layout.tsx b/src/app/[locale]/layout.tsx
index b3307a2..666d126 100644
--- a/src/app/[locale]/layout.tsx
+++ b/src/app/[locale]/layout.tsx
@@ -49,7 +49,9 @@ export default async function LocaleLayout({ children, params }: Props) {
 
   return (
     <html lang={locale} dir={dir(locale)}>
-      <body className="min-h-dvh antialiased">
+      {/* Browser extensions (password managers, WOT, Grammarly…) add attributes to <body> before React
+          loads; this only silences that attribute mismatch on <body>, not on its children. */}
+      <body className="min-h-dvh antialiased" suppressHydrationWarning>
         <SiteHeader locale={locale} t={t} />
         <main id="content" className="mx-auto max-w-[1120px] px-5">
           {children}
-- 
2.43.0

