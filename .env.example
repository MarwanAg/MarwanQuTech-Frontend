# Copy to .env.local for development.

# Where the ASP.NET Core API runs. Used by the browser (contact form, view counter, images).
NEXT_PUBLIC_API_URL=http://localhost:5148

# Used by the Next.js server for page data. Same as above locally; in Docker it can be the
# internal service address (e.g. http://api:8080).
API_INTERNAL_URL=http://localhost:5148

# Public address of this site, used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must equal NextJs:RevalidateSecret in the API. This value matches the API's Development settings;
# use a long random value in production.
REVALIDATE_SECRET=local-dev-revalidate-secret

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable tracking (e.g. locally).
NEXT_PUBLIC_GA_ID=
