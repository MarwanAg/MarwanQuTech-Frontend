diff --git a/src/components/admin/ui.tsx b/src/components/admin/ui.tsx
new file mode 100644
index 0000000..fc704bf
--- /dev/null
+++ b/src/components/admin/ui.tsx
@@ -0,0 +1,138 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+// Small, consistent building blocks for the dashboard forms.
+
+export function Field({
+  label,
+  error,
+  hint,
+  count,
+  max,
+  htmlFor,
+  children,
+}: {
+  label: string;
+  error?: string;
+  hint?: string;
+  count?: number;
+  max?: number;
+  htmlFor?: string;
+  children: React.ReactNode;
+}) {
+  const over = count !== undefined && max !== undefined && count > max;
+  return (
+    <div>
+      <div className="flex items-baseline justify-between gap-3">
+        <label htmlFor={htmlFor} className="text-sm font-medium">
+          {label}
+          {hint && <span className="ms-2 font-normal text-slate">{hint}</span>}
+        </label>
+        {max !== undefined && (
+          <span className={`font-mono text-xs ${over ? "text-[#b45309]" : "text-slate"}`} dir="ltr">
+            {count ?? 0}/{max}
+          </span>
+        )}
+      </div>
+      <div className="mt-1.5">{children}</div>
+      {error && <p className="mt-1 text-sm text-[#b45309] dark:text-[#fdba74]">{error}</p>}
+    </div>
+  );
+}
+
+export const inputClass = (error?: string) =>
+  `w-full rounded-md border bg-surface px-3 py-2 text-[0.95rem] focus:outline-none focus:ring-2 focus:ring-accent/30 ${
+    error ? "border-[#b45309]" : "border-line focus:border-accent"
+  }`;
+
+type ButtonProps = React.ButtonHTMLAttributes<HTMLButtonElement> & { variant?: "primary" | "secondary" | "danger" };
+
+export function Button({ variant = "secondary", className = "", ...props }: ButtonProps) {
+  const styles = {
+    primary: "bg-accent text-accent-ink hover:opacity-90",
+    secondary: "border border-line hover:border-accent hover:text-accent",
+    danger: "border border-[#b45309]/50 text-[#b45309] hover:bg-[#b45309]/10 dark:text-[#fdba74]",
+  }[variant];
+  return (
+    <button
+      type="button"
+      {...props}
+      className={`rounded-md px-4 py-2 text-sm font-medium transition disabled:cursor-not-allowed disabled:opacity-50 ${styles} ${className}`}
+    />
+  );
+}
+
+/** Inline result of the last action: what happened, or what went wrong. */
+export function Notice({ notice }: { notice: { kind: "ok" | "error"; text: string } | null }) {
+  if (!notice) return null;
+  return (
+    <p
+      role={notice.kind === "error" ? "alert" : "status"}
+      className={`rounded-md px-4 py-2.5 text-sm ${
+        notice.kind === "ok"
+          ? "border border-accent/30 bg-accent/10 text-ink"
+          : "border border-[#b45309]/40 bg-[#b45309]/10 text-[#9a3412] dark:text-[#fdba74]"
+      }`}
+    >
+      {notice.text}
+    </p>
+  );
+}
+
+export function useNotice() {
+  const [notice, setNotice] = useState<{ kind: "ok" | "error"; text: string } | null>(null);
+  useEffect(() => {
+    if (notice?.kind !== "ok") return;
+    const timer = setTimeout(() => setNotice(null), 4000);
+    return () => clearTimeout(timer);
+  }, [notice]);
+  return {
+    notice,
+    ok: (text: string) => setNotice({ kind: "ok", text }),
+    error: (text: string) => setNotice({ kind: "error", text }),
+    clear: () => setNotice(null),
+  };
+}
+
+export function StatusBadge({ published }: { published: boolean }) {
+  return (
+    <span
+      className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium ${
+        published ? "bg-accent/15 text-accent" : "bg-slate/15 text-slate"
+      }`}
+    >
+      <span aria-hidden className={`size-1.5 rounded-full ${published ? "bg-accent" : "bg-slate"}`} />
+      {published ? "منشور" : "مسودة"}
+    </span>
+  );
+}
+
+export function PageHeader({ title, actions }: { title: string; actions?: React.ReactNode }) {
+  return (
+    <div className="mb-8 flex flex-wrap items-center justify-between gap-4">
+      <h1 className="text-2xl font-semibold">{title}</h1>
+      {actions && <div className="flex flex-wrap gap-2">{actions}</div>}
+    </div>
+  );
+}
+
+export function Loading() {
+  return <p className="py-10 text-slate">جارٍ التحميل…</p>;
+}
+
+/** Two side-by-side columns: Arabic and English (English inputs set dir="ltr"). Stacks on small screens. */
+export function BilingualColumns({ ar, en }: { ar: React.ReactNode; en: React.ReactNode }) {
+  return (
+    <div className="grid gap-6 lg:grid-cols-2">
+      <fieldset className="grid content-start gap-5 rounded-lg border border-line p-5" dir="rtl" lang="ar">
+        <legend className="px-2 text-sm font-semibold">العربية</legend>
+        {ar}
+      </fieldset>
+      <fieldset className="grid content-start gap-5 rounded-lg border border-line p-5">
+        <legend className="px-2 text-sm font-semibold">English</legend>
+        {en}
+      </fieldset>
+    </div>
+  );
+}
diff --git a/src/lib/admin/client.ts b/src/lib/admin/client.ts
new file mode 100644
index 0000000..bc2e20a
--- /dev/null
+++ b/src/lib/admin/client.ts
@@ -0,0 +1,107 @@
+"use client";
+
+import { publicApiUrl } from "@/lib/urls";
+import type { AuthResponse } from "./types";
+
+/**
+ * Browser-side API client for the dashboard.
+ * - The access token lives only in memory (never localStorage), so an XSS can't steal a lasting session.
+ * - The refresh token is the HttpOnly `mqt_refresh` cookie set by the API; `credentials: "include"` sends it.
+ * - On 401 the client refreshes once (shared by concurrent calls) and retries; if that fails it emits
+ *   `admin:signed-out` so the shell can send the user to the login page.
+ */
+
+export class ApiError extends Error {
+  constructor(
+    public status: number,
+    public code: string,
+    message: string,
+    public fieldErrors: Record<string, string[]> = {},
+  ) {
+    super(message);
+  }
+}
+
+export const SIGNED_OUT_EVENT = "admin:signed-out";
+
+let accessToken: string | null = null;
+let refreshing: Promise<AuthResponse | null> | null = null;
+
+export const setSession = (session: AuthResponse | null) => {
+  accessToken = session?.accessToken ?? null;
+};
+
+/** Exchanges the refresh cookie for a new access token. Concurrent callers share one request. */
+export function refreshSession(): Promise<AuthResponse | null> {
+  refreshing ??= (async () => {
+    try {
+      const response = await fetch(`${publicApiUrl()}/api/auth/refresh`, { method: "POST", credentials: "include" });
+      if (!response.ok) return null;
+      const session = (await response.json()) as AuthResponse;
+      setSession(session);
+      return session;
+    } catch {
+      return null;
+    } finally {
+      queueMicrotask(() => (refreshing = null));
+    }
+  })();
+  return refreshing;
+}
+
+type Options = { method?: string; body?: unknown; form?: FormData };
+
+export async function adminFetch<T = void>(path: string, options: Options = {}, retried = false): Promise<T> {
+  const headers: Record<string, string> = { Accept: "application/json" };
+  if (accessToken) headers.Authorization = `Bearer ${accessToken}`;
+  if (options.body !== undefined) headers["Content-Type"] = "application/json";
+
+  let response: Response;
+  try {
+    response = await fetch(`${publicApiUrl()}${path}`, {
+      method: options.method ?? "GET",
+      headers,
+      credentials: "include",
+      body: options.form ?? (options.body !== undefined ? JSON.stringify(options.body) : undefined),
+    });
+  } catch {
+    throw new ApiError(0, "network", "Network error");
+  }
+
+  if (response.ok) {
+    if (response.status === 204) return undefined as T;
+    const text = await response.text();
+    return (text ? JSON.parse(text) : undefined) as T;
+  }
+
+  const problem = (await response.json().catch(() => ({}))) as {
+    code?: string;
+    detail?: string;
+    title?: string;
+    errors?: Record<string, string[]>;
+  };
+
+  // A 401 without a code means the access token was rejected (expired). Business 401s
+  // such as Auth.WrongPassword carry a code and must not trigger a refresh.
+  if (response.status === 401 && !problem.code && !retried) {
+    const session = await refreshSession();
+    if (session) return adminFetch<T>(path, options, true);
+    setSession(null);
+    window.dispatchEvent(new Event(SIGNED_OUT_EVENT));
+  }
+
+  throw new ApiError(
+    response.status,
+    problem.code ?? `Http.${response.status}`,
+    problem.detail ?? problem.title ?? response.statusText,
+    problem.errors ?? {},
+  );
+}
+
+export const api = {
+  get: <T>(path: string) => adminFetch<T>(path),
+  post: <T = void>(path: string, body?: unknown) => adminFetch<T>(path, { method: "POST", body }),
+  put: <T = void>(path: string, body?: unknown) => adminFetch<T>(path, { method: "PUT", body }),
+  del: (path: string) => adminFetch(path, { method: "DELETE" }),
+  upload: <T>(path: string, form: FormData, method = "POST") => adminFetch<T>(path, { method, form }),
+};
