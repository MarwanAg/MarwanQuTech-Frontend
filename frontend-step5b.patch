+export function formatDateTime(iso: string | null | undefined) {
+  if (!iso) return "—";
+  return new Intl.DateTimeFormat("ar-JO-u-nu-latn", { dateStyle: "medium", timeStyle: "short" }).format(new Date(iso));
+}
